# ==========================================
# RESIN Frontend Environment Variables
# ==========================================

# Supabase Credentials (public anon key is safe for client-side; protected by Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# RAG Backend URL (FastAPI)
# Note: AI (Gemini), News (NewsAPI), and Research (Semantic Scholar) keys are securely configured
# on the FastAPI backend (backend/.env) and never exposed to the client bundle.
VITE_RAG_BACKEND_URL=http://localhost:8000
